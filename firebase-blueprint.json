{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user account information and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Auth ID" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Playlist": {
      "title": "Playlist",
      "description": "A collection of songs generated by AI or curated by the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mood": { "type": "string" },
        "description": { "type": "string" },
        "artworkUrl": { "type": "string" },
        "songs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "artist": { "type": "string" },
              "artwork": { "type": "string" },
              "duration": { "type": "string" }
            }
          }
        },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "songs"]
    },
    "HistoryItem": {
      "title": "Listening History",
      "description": "Record of a song played by the user.",
      "type": "object",
      "properties": {
        "songId": { "type": "string" },
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "playedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["songId", "playedAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profile document."
    },
    "/users/{uid}/playlists/{playlistId}": {
      "schema": "Playlist",
      "description": "User's created playlists."
    },
    "/users/{uid}/history/{historyId}": {
      "schema": "HistoryItem",
      "description": "User's listening history."
    }
  }
}
